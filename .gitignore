# Dependencies
node_modules/

# Python venvs (engine: .venv, coach: riyaz) + caches
**/.venv/
apps/coach/backend/riyaz/
__pycache__/
*.pyc
*.pyo
.karaoke_cache/

# Storage (runtime data, keep .gitkeep)
storage/downloads/*
storage/stems/*
storage/exports/*
!storage/**/.gitkeep

# Next.js
**/.next/
**/out/

# Desktop app (Tauri). The runtime tarball is a ~500MB build artifact rebuilt by
# `make desktop-runtime`; .build/ is its staging area.
**/target/
apps/coach/desktop/src-tauri/runtime/
apps/coach/desktop/src-tauri/gen/schemas/
.build/

# Environment
.env
.env.local
.env*.local
!.env.example

