# GPU worker image. Build from repository root and run only on an NVIDIA ECS
# EC2 capacity provider. Fargate cannot schedule this image with a GPU.
FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-pip ffmpeg git \
    && rm -rf /var/lib/apt/lists/* \
    && ln -s /usr/bin/python3 /usr/local/bin/python

WORKDIR /app
COPY packages/core /app/packages/core
COPY apps/coach/backend /app/apps/coach/backend

WORKDIR /app/apps/coach/backend
RUN python -m pip install --upgrade pip && python -m pip install -r requirements.txt

CMD ["python", "-m", "app.worker"]
